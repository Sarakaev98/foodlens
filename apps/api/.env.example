API_PORT=3000
DATABASE_URL=postgresql://foodlens:foodlens@localhost:5432/foodlens

# Активный AI-провайдер:
#   google — настоящий multimodal анализ фото через Google, настройки GOOGLE_* ниже;
#   meta — настоящий анализ фото через Meta Model API (нужен MODEL_API_KEY);
#   mock — без ключа и без запросов к Meta: любое фото возвращает один и тот же демо-продукт
#          (греческий йогурт), чтобы проверить весь сценарий Scan локально и на iPhone.
# Mock включается только явно, автоматической подмены при пустом ключе нет.
AI_PROVIDER=meta
# Ключ Meta Model API. Только здесь, в apps/api/.env: никогда не в mobile, EXPO_PUBLIC_* или git.
# Без ключа API запускается, а сканирование отвечает AI_NOT_CONFIGURED.
MODEL_API_KEY=
# Необязательно: модель (по умолчанию muse-spark-1.3) и таймаут запроса к Meta в мс (по умолчанию 60000).
# MODEL_NAME=muse-spark-1.3
# MODEL_TIMEOUT_MS=60000

# Goal Match v4 для цели eat_healthier (второй AI-вызов после распознавания):
#   off  — по умолчанию: как раньше, расчётная оценка v3, второго вызова нет;
#   mock — записанные ответы AI для демо-продуктов (йогурт, яблоко, чипсы, кола, протеиновый батончик),
#          для остальных продуктов расчётный fallback; Meta не вызывается;
#   google — настоящий text-only Gemini evaluator; scan image-analysis provider не меняется;
#   meta — зарезервировано: запрос к Meta пока не отправляется, всегда расчётный fallback.
# Остальные цели (lose_weight, maintain_weight, gain_weight) от этой настройки не зависят.
# Поиск продукта по штрихкоду: open_food_facts (по умолчанию) или none.
# PRODUCT_LOOKUP=open_food_facts
# Контакт для User-Agent запросов к Open Food Facts. Перед production указать email проекта.
# OFF_CONTACT=
# Поиск страниц для недостающих значений: off (по умолчанию), tavily или gemini.
# Срабатывает только когда после этикетки и баз остаются пропуски, не больше одного раза на скан.
# gemini (Google Search) оставлен в коде, но его условия не разрешают читать найденные страницы.
# WEB_SEARCH_LOOKUP=off
# Ключ Tavily. Только здесь, в apps/api/.env: никогда не в mobile, EXPO_PUBLIC_* или git.
# TAVILY_API_KEY=
# Сколько кредитов тратить за месяц. Счётчик в памяти API, при перезапуске обнуляется. По умолчанию 900.
# TAVILY_MONTHLY_CREDIT_LIMIT=900
# Второй источник (FatSecret). Только на сервере, не коммитить. Без обоих ключей отключён.
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
# Страна набора данных, например RU; нужен доступ localization. Без неё только набор США.
# FATSECRET_REGION=
# FATSECRET_LANGUAGE=

GOAL_MATCH_AI=off

# Переопределение feature flags (по умолчанию все включены, см. @foodlens/core)
# FEATURE_COMPARE=false
# FEATURE_MEAL_PLAN=false
# FEATURE_HISTORY=false
# FEATURE_BARCODE=false

# Backend-only Google configuration shared by AI_PROVIDER=google and GOAL_MATCH_AI=google. Never put this key in mobile or git.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GEMINI_MODEL=gemini-3.5-flash-lite

API_PORT=3000
DATABASE_URL=postgresql://foodlens:foodlens@localhost:5432/foodlens

# Active AI provider:
#   google — real multimodal photo analysis through Google, see the GOOGLE_* settings below;
#   meta — real photo analysis through the Meta Model API (requires MODEL_API_KEY);
#   mock — no key and no requests to Meta: every photo returns the same demo product
#          (Greek yogurt), so the whole Scan flow can be checked locally and on an iPhone.
# Mock is used only when set explicitly; an empty key never switches to it automatically.
AI_PROVIDER=meta
# Meta Model API key. Only here, in apps/api/.env: never in mobile, EXPO_PUBLIC_* or git.
# Without a key the API starts, and scanning answers AI_NOT_CONFIGURED.
MODEL_API_KEY=
# Optional: the model (default muse-spark-1.3) and the Meta request timeout in ms (default 60000).
# MODEL_NAME=muse-spark-1.3
# MODEL_TIMEOUT_MS=60000

# Goal Match v4 for the eat_healthier goal (a second AI call after recognition):
#   off  — default: the calculated v3 score as before, no second call;
#   mock — recorded AI answers for the demo products (yogurt, apple, chips, cola, protein bar),
#          the calculated fallback for every other product; Meta is not called;
#   google — the real text-only Gemini evaluator; the scan image-analysis provider does not change;
#   meta — reserved: no request is sent to Meta yet, always the calculated fallback.
# Other goals (lose_weight, maintain_weight, gain_weight) do not depend on this setting.
GOAL_MATCH_AI=off

# Barcode product lookup: open_food_facts (default) or none.
# PRODUCT_LOOKUP=open_food_facts
# Contact for the User-Agent of Open Food Facts requests. Set the project email before production.
# OFF_CONTACT=
# Web page search for missing values: off (default), tavily or gemini.
# Runs at most once per scan, and only when the label and the databases still leave gaps.
# gemini (Google Search) stays in the code, but its terms do not allow reading the pages it finds.
# WEB_SEARCH_LOOKUP=off
# Tavily key. Only here, in apps/api/.env: never in mobile, EXPO_PUBLIC_* or git.
# TAVILY_API_KEY=
# Monthly credit budget. The counter lives in API memory and resets on restart. Default 900.
# TAVILY_MONTHLY_CREDIT_LIMIT=900
# Second database source (FatSecret). Server only, never commit. Disabled unless both keys are set.
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
# Dataset country, for example RU; requires localization access. Without it only the US dataset is used.
# FATSECRET_REGION=
# FATSECRET_LANGUAGE=

# Feature flag overrides (all on by default, see @foodlens/core)
# FEATURE_COMPARE=false
# FEATURE_MEAL_PLAN=false
# FEATURE_HISTORY=false
# FEATURE_BARCODE=false

# Backend-only Google configuration shared by AI_PROVIDER=google and GOAL_MATCH_AI=google. Never put this key in mobile or git.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GEMINI_MODEL=gemini-3.5-flash-lite

# API address. Default: the Expo dev server host + port 3000 (works on the same Wi-Fi network).
# For an emulator, a tunnel or another address, set it explicitly:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Feature flag overrides (all on by default, see @foodlens/core)
# EXPO_PUBLIC_FEATURE_COMPARE=false
# EXPO_PUBLIC_FEATURE_MEAL_PLAN=false
# EXPO_PUBLIC_FEATURE_HISTORY=false
# EXPO_PUBLIC_FEATURE_BARCODE=false
# EXPO_PUBLIC_FEATURE_MEAL_PHOTO=false

# Адрес API. По умолчанию: хост Expo dev server + порт 3000 (работает в одной Wi-Fi сети).
# Для эмулятора, туннеля или другого адреса задайте явно:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Переопределение feature flags (по умолчанию все включены, см. @foodlens/core)
# EXPO_PUBLIC_FEATURE_COMPARE=false
# EXPO_PUBLIC_FEATURE_MEAL_PLAN=false
# EXPO_PUBLIC_FEATURE_HISTORY=false
# EXPO_PUBLIC_FEATURE_BARCODE=false
